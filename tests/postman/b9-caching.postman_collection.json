{
 "info": {
  "name": "Recipe Manager - B9 API caching tests",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Run in order on a local disposable database with cookies enabled. Checks that repeated GET requests are served from the output cache (Age header) and that creating, updating or deleting data evicts the affected responses. Deletes only its own records."
 },
 "auth": {
  "type": "noauth"
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "{",
     "const baseUrl = String(pm.environment.get('baseUrl') || '').replace(/\\/$/, '');",
     "const local = /^https?:\\/\\/(localhost|127\\.0\\.0\\.1|\\[::1\\])(:\\d+)?$/i.test(baseUrl);",
     "pm.test('Environment targets a local Recipe Manager', function () { pm.expect(local).to.equal(true); });",
     "if (!local) { pm.execution.skipRequest(); }",
     "pm.variables.set('baseUrl', baseUrl);",
     "}"
    ]
   }
  },
  {
   "listen": "test",
   "script": {
    "type": "text/javascript",
    "exec": [
     "{",
     "const expectedStatus = Number(pm.variables.get('expectedStatus'));",
     "pm.test('Expected HTTP status ' + expectedStatus, function () { pm.response.to.have.status(expectedStatus); });",
     "}"
    ]
   }
  }
 ],
 "item": [
  {
   "name": "01 - Setup",
   "item": [
    {
     "name": "Get antiforgery token",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/antiforgery"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "const data = pm.response.json();",
         "pm.test('Antiforgery token is returned', function () { pm.expect(data.requestToken).to.be.a('string').and.not.empty; });",
         "pm.test('Token response is never cached', function () { pm.expect(pm.response.headers.has('Age')).to.equal(false); });",
         "pm.variables.set('csrfToken', data.requestToken);",
         "pm.variables.set('csrfHeaderName', data.headerName);",
         "pm.variables.set('runId', pm.variables.replaceIn('{{$guid}}'));",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Create category",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "{{csrfHeaderName}}",
        "value": "{{csrfToken}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/categories",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"B9 category {{runId}}\"\n}"
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 201);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('categoryId', pm.response.json().id);",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Create recipe",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "{{csrfHeaderName}}",
        "value": "{{csrfToken}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/recipes",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"title\": \"B9 recipe {{runId}}\",\n  \"description\": \"Output cache check.\",\n  \"instructions\": \"Prepare and serve.\",\n  \"cookingTimeMinutes\": 10,\n  \"servings\": 1,\n  \"categoryId\": \"{{categoryId}}\"\n}"
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 201);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('recipeId', pm.response.json().id);",
         "}"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "02 - Cache hits",
   "item": [
    {
     "name": "First recipe GET reads the database",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/recipes/{{recipeId}}"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('Response is built from the database (no Age header)', function () { pm.expect(pm.response.headers.has('Age')).to.equal(false); });",
         "pm.variables.set('recipeBody', pm.response.text());",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Second recipe GET is a cache hit",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/recipes/{{recipeId}}"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('Response is served from the output cache (Age header)', function () { pm.expect(pm.response.headers.has('Age')).to.equal(true); });",
         "pm.test('Cached body equals the first response', function () { pm.expect(pm.response.text()).to.equal(pm.variables.get('recipeBody')); });",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "First category GET reads the database",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/categories/{{categoryId}}"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('Response is built from the database (no Age header)', function () { pm.expect(pm.response.headers.has('Age')).to.equal(false); });",
         "pm.variables.set('categoryBody', pm.response.text());",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Second category GET is a cache hit",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/categories/{{categoryId}}"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('Response is served from the output cache (Age header)', function () { pm.expect(pm.response.headers.has('Age')).to.equal(true); });",
         "pm.test('Cached body equals the first response', function () { pm.expect(pm.response.text()).to.equal(pm.variables.get('categoryBody')); });",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Warm the category list",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/categories"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('List is a JSON array', function () { pm.expect(Array.isArray(pm.response.json())).to.equal(true); });",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Empty skip is not answered with the cached list",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/categories?skip="
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 400);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('Validation error, not a cached array', function () { pm.expect(pm.response.json().status).to.equal(400); });",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Page request has its own cache entry",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/categories?skip=0&limit=1"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('Paged shape is returned', function () { pm.expect(pm.response.json()).to.have.property('items'); });",
         "}"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "03 - Eviction after changes",
   "item": [
    {
     "name": "Rename category",
     "request": {
      "method": "PUT",
      "header": [
       {
        "key": "{{csrfHeaderName}}",
        "value": "{{csrfToken}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/categories/{{categoryId}}",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"B9 renamed {{runId}}\"\n}"
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Category GET returns the new name",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/categories/{{categoryId}}"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('Response is built from the database (no Age header)', function () { pm.expect(pm.response.headers.has('Age')).to.equal(false); });",
         "pm.test('New name is visible', function () { pm.expect(pm.response.json().name).to.equal(pm.variables.replaceIn('B9 renamed {{runId}}')); });",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Recipe GET shows the renamed category",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/recipes/{{recipeId}}"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('Response is built from the database (no Age header)', function () { pm.expect(pm.response.headers.has('Age')).to.equal(false); });",
         "pm.test('Recipe cache was evicted by the category change', function () { pm.expect(pm.response.json().categoryName).to.equal(pm.variables.replaceIn('B9 renamed {{runId}}')); });",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Update recipe",
     "request": {
      "method": "PUT",
      "header": [
       {
        "key": "{{csrfHeaderName}}",
        "value": "{{csrfToken}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/api/recipes/{{recipeId}}",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"title\": \"B9 updated {{runId}}\",\n  \"description\": \"Output cache check.\",\n  \"instructions\": \"Prepare and serve.\",\n  \"cookingTimeMinutes\": 15,\n  \"servings\": 2,\n  \"categoryId\": \"{{categoryId}}\"\n}"
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Recipe GET returns the update",
     "request": {
      "method": "GET",
      "header": [],
      "url": "{{baseUrl}}/api/recipes/{{recipeId}}"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 200);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.test('Response is built from the database (no Age header)', function () { pm.expect(pm.response.headers.has('Age')).to.equal(false); });",
         "pm.test('Updated values are visible', function () { const r = pm.response.json(); pm.expect(r.cookingTimeMinutes).to.equal(15); pm.expect(r.servings).to.equal(2); });",
         "}"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "04 - Cleanup",
   "item": [
    {
     "name": "Delete recipe",
     "request": {
      "method": "DELETE",
      "header": [
       {
        "key": "{{csrfHeaderName}}",
        "value": "{{csrfToken}}"
       }
      ],
      "url": "{{baseUrl}}/api/recipes/{{recipeId}}"
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "pm.variables.set('expectedStatus', 204);",
         "}"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "{",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Deleted recipe is not served from cache",
     "request": {
      "method": "GET",
