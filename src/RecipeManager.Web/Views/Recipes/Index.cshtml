@model IEnumerable<Recipe>
@{
    ViewData["Title"] = "Recipes";
    ViewData["Description"] = "All recipes in the collection with their category, cooking time and number of servings.";
}

@if (TempData["CreatedRecipeId"] is int createdRecipeId)
{
    @section Analytics {
        <script>
            gtag('event', 'recipe_created', @Json.Serialize(new { recipe_id = createdRecipeId }));
        </script>
    }
}

<h1>Recipes</h1>
<p><a asp-action="Create" class="btn btn-primary">Create recipe</a></p>
@if (!Model.Any())
{
    <p>No recipes yet. Create your first recipe to get started.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead><tr>
                <th scope="col">Title</th>
                <th scope="col">Category</th>
                <th scope="col">Cooking time (minutes)</th>
                <th scope="col">Servings</th>
                <th scope="col">Actions</th>
            </tr></thead>
            <tbody>
            @foreach (var recipe in Model)
            {
                <tr>
                    <td>@recipe.Title</td>
                    <td>@recipe.Category.Name</td>
                    <td>@recipe.CookingTimeMinutes</td>
                    <td>@recipe.Servings</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@recipe.Id">Details</a> |
                        <a asp-action="Edit" asp-route-id="@recipe.Id">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@recipe.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
