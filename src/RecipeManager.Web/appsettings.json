{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=recipe-manager.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FeatureManagement": {
    "RecipeExport": {
      "EnabledFor": [ { "Name": "Plan", "Parameters": { "Plans": [ "Premium" ] } } ]
    },
    "UnlimitedRecipes": {
      "EnabledFor": [ { "Name": "Plan", "Parameters": { "Plans": [ "Premium" ] } } ]
    },
    "AiAssistant": {
      "EnabledFor": [ { "Name": "Plan", "Parameters": { "Plans": [ "Premium" ] } } ]
    }
  },
  "OpenRouter": {
    "Model": "deepseek/deepseek-v4.1-flash-1017",
    "MaxTokens": 2000
  },
  "Plans": {
    "FreeRecipeLimit": 20
  },
  "Analytics": {
    "MeasurementId": "G-QFPHFQCPRZ"
  },
  "AllowedHosts": "*"
}
